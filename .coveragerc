[run]
branch = True
relative_files = True
# "." makes coverage.xml paths relative to the project root (what SonarQube
# expects). The subject under analysis is src/shopflow only.
source = .
omit =
    tests/*
    src/sonar_tools/*
    fixtures/*
    scripts/*
    */__pycache__/*

[report]
show_missing = True
skip_empty = True

[xml]
output = reports/coverage.xml
